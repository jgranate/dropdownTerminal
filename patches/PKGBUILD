pkgname=qmltermwidget-dank
pkgver=2.0.0.git1.dank2
pkgrel=1
pkgdesc="QML terminal widget with themed rendering, activity, and scrollback search APIs"
arch=(x86_64)
url="https://github.com/Swordfish90/qmltermwidget"
license=(GPL-2.0-only)
depends=(qt6-declarative)
makedepends=(git)
provides=(qmltermwidget=2.0.0.git1)
conflicts=(qmltermwidget)
source=(
  "git+$url.git#commit=ce8e09ad4daeb9fe59b60d6b228b0f7cf4055e16"
  qmltermwidget-background-opacity-cursor-color.patch
  qmltermwidget-tabs-scrollback.patch
)
sha256sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
  cd qmltermwidget
  patch -Np1 -i "$srcdir/qmltermwidget-background-opacity-cursor-color.patch"
  patch -Np1 -i "$srcdir/qmltermwidget-tabs-scrollback.patch"
}

build() {
  cd qmltermwidget
  qmake6
  make -j1
}

package() {
  cd qmltermwidget
  make -j1 INSTALL_ROOT="$pkgdir" install

  # This setup keeps schemes in ~/.local/share and links the QML import path
  # there. Do not package the upstream scheme directory so Pacman preserves
  # that user-managed symlink during stock/custom package replacements.
  rm -rf "$pkgdir/usr/lib/qt6/qml/QMLTermWidget/color-schemes"
}
