+void TerminalDisplay::setCursorColor(const QColor& color)
+{
+    if (_cursorColor == color)
+        return;
+
+    setKeyboardCursorColor(!color.isValid(), color);
+    updateCursor();
+    emit cursorColorChanged();
+}
