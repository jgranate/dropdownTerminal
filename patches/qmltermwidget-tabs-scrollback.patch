+void TerminalDisplay::revealSearchMatch(int startColumn, int startLine,
+                                        int endColumn, int endLine)
+{
+    if (!_screenWindow)
+        return;
+
+    const int topLine = qMax(0, startLine - (_screenWindow->windowLines() / 2));
+    _screenWindow->scrollTo(topLine);
+    _screenWindow->clearSelection();
+    _screenWindow->setSelectionStart(startColumn,
+                                     startLine - _screenWindow->currentLine(), false);
+    _screenWindow->setSelectionEnd(endColumn,
+                                   endLine - _screenWindow->currentLine());
+    updateLineProperties();
+    updateImage();
+    update();
+}
